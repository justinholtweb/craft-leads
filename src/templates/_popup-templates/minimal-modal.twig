<div class="leads-popup leads-modal leads-minimal" data-leads-id="{{ popup.id }}" style="background-color: {{ popup.backgroundColor ?? '#ffffff' }};">
    <button class="leads-close" data-leads-close aria-label="Close">&times;</button>
    {% if popup.heading %}
        <h2 class="leads-heading">{{ popup.heading }}</h2>
    {% endif %}
    <form class="leads-form" data-leads-form>
        <input type="hidden" name="popupId" value="{{ popup.id }}">
        {% for field in popup.getFormFieldsArray() %}
            <input type="{{ field.type ?? 'text' }}" name="{{ field.name }}" placeholder="{{ field.placeholder ?? '' }}" {% if field.required ?? false %}required{% endif %} class="leads-input">
        {% else %}
            <input type="email" name="email" placeholder="Your email address" required class="leads-input">
        {% endfor %}
        <button type="submit" class="leads-btn" style="background-color: {{ popup.buttonColor ?? '#3b82f6' }}">{{ popup.buttonText ?? 'Subscribe' }}</button>
    </form>
    <div class="leads-success" style="display:none;">
        <p>Thanks for subscribing!</p>
    </div>
</div>
