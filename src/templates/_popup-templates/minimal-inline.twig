<div class="leads-popup leads-inline leads-minimal" data-leads-id="{{ popup.id }}" style="background-color: {{ popup.backgroundColor ?? '#f8fafc' }};">
    {% if popup.heading %}
        <h3 class="leads-heading">{{ popup.heading }}</h3>
    {% endif %}
    {% if popup.bodyText %}
        <p class="leads-body">{{ popup.bodyText }}</p>
    {% endif %}
    <form class="leads-form leads-form-inline" data-leads-form>
        <input type="hidden" name="popupId" value="{{ popup.id }}">
        {% for field in popup.getFormFieldsArray() %}
            <input type="{{ field.type ?? 'text' }}" name="{{ field.name }}" placeholder="{{ field.placeholder ?? '' }}" {% if field.required ?? false %}required{% endif %} class="leads-input">
        {% else %}
            <input type="email" name="email" placeholder="Your email address" required class="leads-input">
        {% endfor %}
        {% include 'leads/_popup-templates/_consent' %}
        <button type="submit" class="leads-btn" style="background-color: {{ popup.buttonColor ?? '#3b82f6' }}">{{ popup.buttonText ?? 'Subscribe' }}</button>
    </form>
    <div class="leads-success" style="display:none;">
        <p>{{ popup.sendsConfirmation ? 'Almost done: check your inbox and click the link to confirm.'|t('leads') : 'Thanks for subscribing!'|t('leads') }}</p>
    </div>
</div>
