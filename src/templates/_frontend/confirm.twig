{#
 # Leads' own confirmation page. Self-contained: it's a plugin template, so it can't extend the
 # site's layout. Set "Confirmation page template" in Leads' settings to use one of the site's.
 #
 # state: ask | confirmed | invalid
 #}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    {# The token is in this page's URL. The header says the same, but another plugin can add its own. #}
    <meta name="referrer" content="no-referrer">
    <title>{{ (state == 'confirmed' ? 'Subscription confirmed' : (state == 'ask' ? 'Confirm your subscription' : 'Link expired'))|t('leads') }} – {{ siteName }}</title>
    <style>
        :root { color-scheme: light dark; --bg: #f8fafc; --card: #ffffff; --text: #1e293b; --muted: #64748b; --accent: #2563eb; }
        @media (prefers-color-scheme: dark) { :root { --bg: #0f172a; --card: #1e293b; --text: #e2e8f0; --muted: #94a3b8; --accent: #60a5fa; } }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--text); font: 16px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        main { box-sizing: border-box; width: calc(100% - 32px); max-width: 460px; padding: 32px; border-radius: 12px; background: var(--card); box-shadow: 0 10px 30px rgba(0, 0, 0, .08); text-align: center; }
        h1 { margin: 0 0 12px; font-size: 1.4rem; }
        p { margin: 0 0 20px; color: var(--muted); }
        button { padding: 12px 24px; border: 0; border-radius: 8px; background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
        a { color: var(--accent); }
    </style>
</head>
<body>
<main>
    {% if state == 'ask' %}
        <h1>{{ 'Confirm your subscription'|t('leads') }}</h1>
        <p>{{ 'One click and you’re signed up to {siteName}.'|t('leads', { siteName: siteName }) }}</p>
        <form method="post">
            {{ csrfInput() }}
            {{ actionInput('leads/confirm/index') }}
            {{ hiddenInput('code', code) }}
            <button type="submit">{{ 'Confirm'|t('leads') }}</button>
        </form>
    {% elseif state == 'confirmed' %}
        <h1>{{ 'You’re subscribed'|t('leads') }}</h1>
        <p>{{ 'Thanks for confirming. You’ll hear from {siteName} soon.'|t('leads', { siteName: siteName }) }}</p>
        <a href="{{ siteUrl() }}">{{ 'Back to the site'|t('leads') }}</a>
    {% else %}
        <h1>{{ 'This link has expired'|t('leads') }}</h1>
        <p>{{ 'It may already have been used, or it’s too old. Sign up again to get a new one.'|t('leads') }}</p>
        <a href="{{ siteUrl() }}">{{ 'Back to the site'|t('leads') }}</a>
    {% endif %}
</main>
</body>
</html>
