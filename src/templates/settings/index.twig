{% extends 'leads/_layouts/plugin' %}
{% import '_includes/forms' as forms %}

{% set title = 'Leads Settings'|t('leads') %}
{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = not readOnly %}

{% block pluginContent %}
    {% if readOnly %}
        <p class="notice has-icon">
            <span class="icon" aria-hidden="true"></span>
            <span class="visually-hidden">{{ 'Note:'|t('app') }} </span>
            <span>{{ (currentUser.admin
                ? 'Admin changes are turned off on this environment. Change settings where they are allowed and deploy the project config.'
                : 'Settings are project config, so only an admin can change them.')|t('leads') }}</span>
        </p>
        <fieldset disabled class="leads-readonly">
    {% endif %}
    <input type="hidden" name="action" value="leads/settings/save">
    {{ redirectInput('leads/settings') }}

    <div id="fields">
        <h2>{{ 'General'|t('leads') }}</h2>

        {{ forms.lightswitchField({
            label: 'Auto-Inject Script'|t('leads'),
            instructions: 'Automatically inject the popup script on all frontend pages. Disable to use the manual {{ leadsPopups() }} Twig function.'|t('leads'),
            id: 'autoInjectScript',
            name: 'settings[autoInjectScript]',
            on: settings.autoInjectScript,
        }) }}

        <hr>

        <h2>{{ 'Defaults'|t('leads') }}</h2>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.colorField({
                    label: 'Default Button Color'|t('leads'),
                    id: 'defaultButtonColor',
                    name: 'settings[defaultButtonColor]',
                    value: settings.defaultButtonColor,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.colorField({
                    label: 'Default Background Color'|t('leads'),
                    id: 'defaultBackgroundColor',
                    name: 'settings[defaultBackgroundColor]',
                    value: settings.defaultBackgroundColor,
                }) }}
            </div>
        </div>

        <hr>

        <h2>{{ 'Spam Protection'|t('leads') }}</h2>

        {{ forms.lightswitchField({
            label: 'Enable Honeypot'|t('leads'),
            instructions: 'Adds a hidden field to catch spam bots.'|t('leads'),
            id: 'enableHoneypot',
            name: 'settings[enableHoneypot]',
            on: settings.enableHoneypot,
        }) }}

        {{ forms.textField({
            label: 'Rate Limit Per Minute'|t('leads'),
            instructions: 'Maximum form submissions per IP per minute.'|t('leads'),
            id: 'rateLimitPerMinute',
            name: 'settings[rateLimitPerMinute]',
            value: settings.rateLimitPerMinute,
            type: 'number',
            min: 1,
            max: 60,
        }) }}

        {{ forms.textField({
            label: 'Tracking Events Per Minute'|t('leads'),
            instructions: 'Most impressions, conversions and closes one address can record in a minute. Behind a proxy or CDN, set Craft’s `trustedHosts`, or every visitor shares the proxy’s limit.'|t('leads'),
            id: 'trackingPerMinute',
            name: 'settings[trackingPerMinute]',
            value: settings.trackingPerMinute,
            type: 'number',
            min: 1,
            max: 600,
        }) }}

        <hr>

        <h2>{{ 'Double Opt-in'|t('leads') }}</h2>

        <p class="light">{{ 'Used by popups whose double opt-in is set to “Leads emails a confirmation link”. Sent with Craft’s email settings.'|t('leads') }}</p>

        {{ forms.textField({
            label: 'Confirmation Email Subject'|t('leads'),
            instructions: '`{siteName}` and `{popup}` are filled in.'|t('leads'),
            id: 'confirmationSubject',
            name: 'settings[confirmationSubject]',
            value: settings.confirmationSubject,
            errors: settings.getErrors('confirmationSubject'),
        }) }}

        {{ forms.textareaField({
            label: 'Confirmation Email'|t('leads'),
            instructions: 'Plain text. `{link}` (required), `{siteName}`, `{popup}` and `{hours}` are filled in.'|t('leads'),
            id: 'confirmationBody',
            name: 'settings[confirmationBody]',
            value: settings.confirmationBody,
            rows: 8,
            errors: settings.getErrors('confirmationBody'),
        }) }}

        {{ forms.textField({
            label: 'Link Expiry (Hours)'|t('leads'),
            instructions: 'How long a confirmation link works. Sign-ups not confirmed by then are deleted.'|t('leads'),
            id: 'confirmationExpiryHours',
            name: 'settings[confirmationExpiryHours]',
            value: settings.confirmationExpiryHours,
            type: 'number',
            min: 1,
            max: 720,
            errors: settings.getErrors('confirmationExpiryHours'),
        }) }}

        {{ forms.textField({
            label: 'Confirmation Page Template'|t('leads'),
            instructions: 'A site template to show the confirmation page with. It gets `state` (`ask`, `confirmed` or `invalid`), `code` and `popup`, and has to post `code` to `leads/confirm/index`. Leave blank for Leads’ own page.'|t('leads'),
            id: 'confirmationTemplate',
            name: 'settings[confirmationTemplate]',
            value: settings.confirmationTemplate,
            class: 'code',
            errors: settings.getErrors('confirmationTemplate'),
        }) }}

        {{ forms.textField({
            label: 'Lock Consent Purpose'|t('leads'),
            instructions: (lockInstalled
                ? 'A confirmed sign-up whose consent box was ticked is recorded in Lock’s consent ledger under this purpose. Leave blank to not record it.'
                : 'When Lock is installed, a confirmed sign-up whose consent box was ticked is recorded in its consent ledger under this purpose.')|t('leads'),
            id: 'lockPurpose',
            name: 'settings[lockPurpose]',
            value: settings.lockPurpose,
            class: 'code',
            errors: settings.getErrors('lockPurpose'),
        }) }}

        {% if tossActive %}
            <p class="light">{{ 'Toss is managing cookie consent on this site, so each submission also records the visitor’s Toss consent choices.'|t('leads') }}</p>
        {% endif %}

        <hr>

        <h2>{{ 'Data'|t('leads') }}</h2>

        {{ forms.textField({
            label: 'Data Retention (Days)'|t('leads'),
            instructions: 'Number of days to keep submission data. Set to 0 to keep forever.'|t('leads'),
            id: 'dataRetentionDays',
            name: 'settings[dataRetentionDays]',
            value: settings.dataRetentionDays,
            type: 'number',
            min: 0,
        }) }}
    </div>
    {% if readOnly %}
        </fieldset>
    {% endif %}
{% endblock %}
