{% extends 'leads/_layouts/plugin' %}

{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = 'popups' %}
{% set fullPageForm = true %}

{% block pluginContent %}
    <input type="hidden" name="action" value="leads/popups/save">
    {{ redirectInput('leads/popups') }}

    {% if not isNew %}
        <input type="hidden" name="popupId" value="{{ popup.id }}">
    {% endif %}

    <div id="fields">
        {{ forms.textField({
            label: 'Title'|t('leads'),
            instructions: 'Internal name for this popup.'|t('leads'),
            id: 'title',
            name: 'title',
            value: popup.title,
            errors: popup.getErrors('title'),
            required: true,
            first: true,
        }) }}

        <hr>

        <h2>{{ 'Popup Settings'|t('leads') }}</h2>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'Popup Type'|t('leads'),
                    id: 'popupType',
                    name: 'popupType',
                    value: popup.popupType,
                    options: popupTypeOptions,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'Status'|t('leads'),
                    id: 'popupStatus',
                    name: 'popupStatus',
                    value: popup.popupStatus,
                    options: statusOptions,
                }) }}
            </div>
        </div>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'Template'|t('leads'),
                    instructions: designsFolder
                        ? 'Your own designs are the templates in `templates/{folder}`.'|t('leads', { folder: designsFolder })
                        : null,
                    id: 'templateKey',
                    name: 'templateKey',
                    value: popup.templateKey,
                    options: templateOptions,
                    errors: popup.getErrors('templateKey'),
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'Position'|t('leads'),
                    instructions: 'For bars and slide-ins.'|t('leads'),
                    id: 'position',
                    name: 'position',
                    value: popup.position,
                    options: positionOptions,
                }) }}
            </div>
        </div>

        {{ forms.textField({
            label: 'Priority'|t('leads'),
            instructions: 'Lower numbers display first when multiple popups match.'|t('leads'),
            id: 'priority',
            name: 'priority',
            value: popup.priority,
            type: 'number',
            min: 0,
        }) }}

        <hr>

        <h2>{{ 'Trigger'|t('leads') }}</h2>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'Trigger Type'|t('leads'),
                    id: 'triggerType',
                    name: 'triggerType',
                    value: popup.triggerType,
                    options: triggerTypeOptions,
                }) }}
            </div>
            <div class="flex-grow">
                <div id="leads-trigger-value"{% if popup.triggerType == 'exit' %} class="hidden"{% endif %}>
                    {{ forms.textField({
                        label: 'Trigger Value'|t('leads'),
                        instructions: 'Seconds for time delay, percentage for scroll, CSS selector for click, seconds without input for idle (30 if blank), CSS selector of the element for element in view.'|t('leads'),
                        id: 'triggerValue',
                        name: 'triggerValue',
                        value: popup.triggerType != 'exit' ? popup.triggerValue : '',
                        errors: popup.triggerType != 'exit' ? popup.getErrors('triggerValue') : [],
                    }) }}
                </div>
                <div id="leads-trigger-exit"{% if popup.triggerType != 'exit' %} class="hidden"{% endif %}>
                    {{ forms.textField({
                        label: 'Fallback on phones and tablets'|t('leads'),
                        instructions: 'There, exit intent is a quick scroll back up. Visitors on a short page may never do that: show the popup after this many seconds instead. Leave blank for no fallback.'|t('leads'),
                        id: 'exitFallback',
                        name: 'exitFallback',
                        value: popup.triggerType == 'exit' ? popup.triggerValue : '',
                        type: 'number',
                        min: 1,
                        max: 600,
                        size: 5,
                        placeholder: '20',
                        errors: popup.triggerType == 'exit' ? popup.getErrors('triggerValue') : [],
                    }) }}
                </div>
            </div>
        </div>
        {% js %}
        document.getElementById('triggerType')?.addEventListener('change', function(e) {
            var exit = e.currentTarget.value === 'exit';
            document.getElementById('leads-trigger-value').classList.toggle('hidden', exit);
            document.getElementById('leads-trigger-exit').classList.toggle('hidden', !exit);
        });
        {% endjs %}

        <hr>

        <h2>{{ 'Content'|t('leads') }}</h2>

        {{ forms.textField({
            label: 'Heading'|t('leads'),
            id: 'heading',
            name: 'heading',
            value: popup.heading,
        }) }}

        {{ forms.textareaField({
            label: 'Body Text'|t('leads'),
            id: 'bodyText',
            name: 'bodyText',
            value: popup.bodyText,
            rows: 4,
        }) }}

        <div class="flex">
            <div class="flex-grow">
                {{ forms.textField({
                    label: 'Button Text'|t('leads'),
                    id: 'buttonText',
                    name: 'buttonText',
                    value: popup.buttonText,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.colorField({
                    label: 'Button Color'|t('leads'),
                    id: 'buttonColor',
                    name: 'buttonColor',
                    value: popup.buttonColor,
                }) }}
            </div>
        </div>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.colorField({
                    label: 'Background Color'|t('leads'),
                    id: 'backgroundColor',
                    name: 'backgroundColor',
                    value: popup.backgroundColor,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.textField({
                    label: 'Background Image URL'|t('leads'),
                    id: 'backgroundImage',
                    name: 'backgroundImage',
                    value: popup.backgroundImage,
                }) }}
            </div>
        </div>

        {{ forms.textareaField({
            label: 'Custom CSS'|t('leads'),
            instructions: 'Additional CSS for this popup.'|t('leads'),
            id: 'customCss',
            name: 'customCss',
            value: popup.customCss,
            rows: 4,
            class: 'code',
        }) }}

        <hr>

        <h2>{{ 'Integration'|t('leads') }}</h2>

        {% set integration = popup.getIntegrationSettingsArray() %}
        {% set provider = popup.integrationProvider %}

        {{ forms.selectField({
            label: 'Email Integration'|t('leads'),
            id: 'integrationProvider',
            name: 'integrationProvider',
            value: provider,
            options: integrationOptions,
            toggle: true,
            targetPrefix: 'integration-',
            errors: popup.getErrors('integrationSettings'),
        }) }}

        {% set envHint = 'Name an environment variable such as `$MAILCHIMP_API_KEY` to keep it out of the database.'|t('leads') %}

        <div id="integration-mailchimp"{% if provider != 'mailchimp' %} class="hidden"{% endif %}>
            {{ forms.autosuggestField({
                label: 'Mailchimp API Key'|t('leads'),
                instructions: envHint,
                id: 'mailchimpApiKey',
                name: 'integrationSettings[apiKey]',
                value: provider == 'mailchimp' ? (integration.apiKey ?? '') : '',
                suggestEnvVars: true,
                class: 'code',
            }) }}
            {{ forms.textField({
                label: 'Audience ID'|t('leads'),
                id: 'mailchimpListId',
                name: 'integrationSettings[listId]',
                value: provider == 'mailchimp' ? (integration.listId ?? '') : '',
                class: 'code',
            }) }}
        </div>

        <div id="integration-convertkit"{% if provider != 'convertkit' %} class="hidden"{% endif %}>
            {{ forms.autosuggestField({
                label: 'ConvertKit API Secret'|t('leads'),
                instructions: envHint,
                id: 'convertkitApiSecret',
                name: 'integrationSettings[apiSecret]',
                value: provider == 'convertkit' ? (integration.apiSecret ?? '') : '',
                suggestEnvVars: true,
                class: 'code',
            }) }}
            {{ forms.textField({
                label: 'Form ID'|t('leads'),
                id: 'convertkitFormId',
                name: 'integrationSettings[formId]',
                value: provider == 'convertkit' ? (integration.formId ?? '') : '',
                class: 'code',
            }) }}
        </div>

        <div id="integration-webhook"{% if provider != 'webhook' %} class="hidden"{% endif %}>
            {{ forms.autosuggestField({
                label: 'Webhook URL'|t('leads'),
                instructions: 'Each submission is POSTed here as JSON. It has to be a public address; redirects aren’t followed.'|t('leads'),
                id: 'webhookUrl',
                name: 'integrationSettings[webhookUrl]',
                value: provider == 'webhook' ? (integration.webhookUrl ?? '') : '',
                suggestEnvVars: true,
                class: 'code',
            }) }}
        </div>

        <hr>

        <h2>{{ 'Consent & Confirmation'|t('leads') }}</h2>

        {% set consent = popup.getConsent() %}
        {{ forms.errorList(popup.getErrors('consentSettings')) }}

        {{ forms.lightswitchField({
            label: 'Ask for consent'|t('leads'),
            instructions: 'Show a checkbox under the fields. Each submission keeps the wording it was shown, with the date.'|t('leads'),
            id: 'consentCheckbox',
            name: 'consentSettings[checkbox]',
            on: consent.checkbox,
            toggle: 'leads-consent-fields',
        }) }}

        <div id="leads-consent-fields"{% if not consent.checkbox %} class="hidden"{% endif %}>
            {{ forms.textareaField({
                label: 'Consent text'|t('leads'),
                instructions: 'What the checkbox says. Plain text; write `[privacy policy](/privacy)` for a link.'|t('leads'),
                id: 'consentText',
                name: 'consentSettings[text]',
                value: consent.text ?: defaultConsentText,
                rows: 2,
            }) }}

            {{ forms.lightswitchField({
                label: 'Required'|t('leads'),
                instructions: 'The form won’t submit until the box is ticked.'|t('leads'),
                id: 'consentRequired',
                name: 'consentSettings[required]',
                on: consent.required,
            }) }}
        </div>

        {{ forms.selectField({
            label: 'Double opt-in'|t('leads'),
            instructions: 'With Leads sending the email, a sign-up goes to the integration only after the visitor clicks the link in it. Unconfirmed sign-ups are deleted once the link expires.'|t('leads'),
            id: 'consentDoubleOptIn',
            name: 'consentSettings[doubleOptIn]',
            value: consent.doubleOptIn,
            options: doubleOptInOptions,
        }) }}

        <hr>

        <h2>{{ 'Targeting Rules'|t('leads') }}</h2>

        {% set targeting = popup.getTargeting() %}
        {{ forms.errorList(popup.getErrors('targetingRules')) }}

        <div class="flex">
            <div class="flex-grow">
                {{ forms.textareaField({
                    label: 'Show on'|t('leads'),
                    instructions: 'URL patterns, one per line, such as `/blog/*`. `*` matches anything. Leave blank for every page.'|t('leads'),
                    id: 'targetingPages',
                    name: 'targetingRules[pages]',
                    value: targeting.pages|join("\n"),
                    rows: 4,
                    class: 'code',
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.textareaField({
                    label: 'Don’t show on'|t('leads'),
                    instructions: 'URL patterns, one per line. These win over “Show on”.'|t('leads'),
                    id: 'targetingExcludePages',
                    name: 'targetingRules[excludePages]',
                    value: targeting.excludePages|join("\n"),
                    rows: 4,
                    class: 'code',
                }) }}
            </div>
        </div>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.dateTimeField({
                    label: 'Start'|t('leads'),
                    instructions: 'Leave blank to start straight away.'|t('leads'),
                    id: 'targetingStartDate',
                    name: 'targetingRules[startDate]',
                    value: targeting.startDate ? date(targeting.startDate) : null,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.dateTimeField({
                    label: 'End'|t('leads'),
                    instructions: 'Leave blank to keep running. Checked in the visitor’s browser too, so cached pages stop showing it on time.'|t('leads'),
                    id: 'targetingEndDate',
                    name: 'targetingRules[endDate]',
                    value: targeting.endDate ? date(targeting.endDate) : null,
                }) }}
            </div>
        </div>

        {{ forms.checkboxSelectField({
            label: 'Devices'|t('leads'),
            instructions: 'Decided in the visitor’s browser, so it holds on cached pages.'|t('leads'),
            id: 'targetingDevices',
            name: 'targetingRules[devices]',
            options: deviceOptions,
            values: targeting.devices ?: deviceOptions|column('value'),
        }) }}

        <div class="flex">
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'How often'|t('leads'),
                    instructions: 'How often one visitor may see this popup.'|t('leads'),
                    id: 'targetingFrequency',
                    name: 'targetingRules[frequency]',
                    value: targeting.frequency,
                    options: frequencyOptions,
                    toggle: true,
                    targetPrefix: 'leads-frequency-',
                }) }}
            </div>
            <div class="flex-grow">
                <div id="leads-frequency-days"{% if targeting.frequency != 'days' %} class="hidden"{% endif %}>
                    {{ forms.textField({
                        label: 'Days between showings'|t('leads'),
                        id: 'targetingFrequencyDays',
                        name: 'targetingRules[frequencyDays]',
                        value: targeting.frequencyDays,
                        type: 'number',
                        min: 1,
                        max: 3650,
                        size: 5,
                    }) }}
                </div>
            </div>
        </div>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'Visitors'|t('leads'),
                    instructions: 'A new visitor is on their first visit; a returning one has been before.'|t('leads'),
                    id: 'targetingVisitor',
                    name: 'targetingRules[visitor]',
                    value: targeting.visitor,
                    options: visitorOptions,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.textField({
                    label: 'After page views'|t('leads'),
                    instructions: 'Show only from the visitor’s Nth page view on the site. 0 for straight away.'|t('leads'),
                    id: 'targetingMinPageViews',
                    name: 'targetingRules[minPageViews]',
                    value: targeting.minPageViews,
                    type: 'number',
                    min: 0,
                    max: 1000,
                    size: 5,
                }) }}
            </div>
        </div>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.textField({
                    label: 'Days hidden after closing'|t('leads'),
                    instructions: 'How long a visitor who closes the popup goes without seeing it. 0 to show it again on the next page.'|t('leads'),
                    id: 'targetingDismissDays',
                    name: 'targetingRules[dismissDays]',
                    value: targeting.dismissDays,
                    type: 'number',
                    min: 0,
                    max: 3650,
                    size: 5,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.lightswitchField({
                    label: 'Hide after signing up'|t('leads'),
                    instructions: 'Never show it again to a visitor who has submitted it.'|t('leads'),
                    id: 'targetingHideAfterConversion',
                    name: 'targetingRules[hideAfterConversion]',
                    on: targeting.hideAfterConversion,
                }) }}
            </div>
        </div>

        {{ forms.textareaField({
            label: 'Traffic source'|t('leads'),
            instructions: 'Show only to visitors who arrived this way, one per line: a UTM parameter such as `utm_campaign=spring-sale`, or a referring site such as `google.com` (its subdomains too). `*` matches anything. Taken from the page the visit started on, or a later one with UTM parameters, and kept for the visit. Leave blank for everyone.'|t('leads'),
            id: 'targetingSources',
            name: 'targetingRules[sources]',
            value: targeting.sources|join("\n"),
            rows: 3,
            class: 'code',
        }) }}

        <h3>{{ 'Signed-in users'|t('leads') }}</h3>

        <div class="flex">
            <div class="flex-grow">
                {{ forms.selectField({
                    label: 'Signed in'|t('leads'),
                    instructions: 'Asked of the server by the page script, so it holds on cached pages.'|t('leads'),
                    id: 'targetingAudience',
                    name: 'targetingRules[audience]',
                    value: targeting.audience,
                    options: audienceOptions,
                }) }}
            </div>
            <div class="flex-grow">
                {% if groupOptions %}
                    {{ forms.checkboxSelectField({
                        label: 'User groups'|t('leads'),
                        instructions: 'Only signed-in users in any of these groups. None ticked for any user.'|t('leads'),
                        id: 'targetingUserGroups',
                        name: 'targetingRules[userGroups]',
                        options: groupOptions,
                        values: targeting.userGroups,
                    }) }}
                {% endif %}
            </div>
        </div>

        {% if commerceActive or targeting.cart != 'any' or targeting.cartMin is not null or targeting.cartBelow is not null or targeting.cartCategories %}
            <h3>{{ 'Cart'|t('leads') }}</h3>
            {% if not commerceActive %}
                <p class="warning with-icon">{{ 'Cart rules need Craft Commerce.'|t('leads') }}</p>
            {% endif %}

            <div class="flex">
                <div class="flex-grow">
                    {{ forms.selectField({
                        label: 'Cart'|t('leads'),
                        id: 'targetingCart',
                        name: 'targetingRules[cart]',
                        value: targeting.cart,
                        options: cartOptions,
                    }) }}
                </div>
                <div class="flex-grow">
                    {{ forms.textField({
                        label: 'Subtotal at least'|t('leads'),
                        instructions: 'The cart’s items, before discounts and shipping.'|t('leads'),
                        id: 'targetingCartMin',
                        name: 'targetingRules[cartMin]',
                        value: targeting.cartMin,
                        type: 'number',
                        min: 0,
                        step: 'any',
                        size: 8,
                    }) }}
                </div>
                <div class="flex-grow">
                    {{ forms.textField({
                        label: 'Subtotal below'|t('leads'),
                        instructions: 'For a free-shipping nudge: your threshold.'|t('leads'),
                        id: 'targetingCartBelow',
                        name: 'targetingRules[cartBelow]',
                        value: targeting.cartBelow,
                        type: 'number',
                        min: 0,
                        step: 'any',
                        size: 8,
                    }) }}
                </div>
            </div>

            <div class="flex">
                <div class="flex-grow">
                    {{ forms.elementSelectField({
                        label: 'Holds a product in these categories'|t('leads'),
                        instructions: 'Any of them, or a category under one.'|t('leads'),
                        id: 'targetingCartCategories',
                        name: 'targetingRules[cartCategories]',
                        elementType: 'craft\\elements\\Category',
                        elements: cartCategories,
                    }) }}
                </div>
                <div class="flex-grow">
                    {{ forms.elementSelectField({
                        label: '…or related to these entries'|t('leads'),
                        instructions: 'For a catalogue organised with entries in a structure; an entry under one counts too.'|t('leads'),
                        id: 'targetingCartEntries',
                        name: 'targetingRules[cartCategories]',
                        elementType: 'craft\\elements\\Entry',
                        elements: cartEntries,
                    }) }}
                </div>
            </div>

            <p class="light">{{ 'After an add to cart by Ajax, fire {code} and popups whose trigger has already fired are checked again.'|t('leads', { code: '<code>window.dispatchEvent(new Event(\'leads:cart-changed\'))</code>' })|raw }}</p>
        {% endif %}
    </div>

    {% if not isNew %}
        <hr>
        {# Not a nested <form>: inside the page's form a browser drops the inner form tag, and its
           `action` input then rides along with every Save. #}
        <div class="buttons">
            <button type="button" class="btn" id="leads-duplicate" data-popup-id="{{ popup.id }}">{{ 'Duplicate'|t('leads') }}</button>
        </div>
        {% js %}
        document.getElementById('leads-duplicate')?.addEventListener('click', function(e) {
            var button = e.currentTarget;
            button.disabled = true;
            Craft.sendActionRequest('POST', 'leads/popups/duplicate', { data: { popupId: button.dataset.popupId } })
                .then(function(response) {
                    window.location.href = Craft.getCpUrl('leads/popups/' + response.data.id);
                })
                .catch(function(error) {
                    button.disabled = false;
                    Craft.cp.displayError(error?.response?.data?.message || Craft.t('leads', 'Couldn’t duplicate popup.'));
                });
        });
        {% endjs %}
    {% endif %}
{% endblock %}
