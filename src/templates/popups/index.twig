{% extends 'leads/_layouts/plugin' %}

{% set title = 'Popups'|t('leads') %}
{% set selectedSubnavItem = 'popups' %}
{% set elementType = elementType %}

{% block pluginContent %}
    {{ craft.app.view.renderTemplate('_elements/indexcontainer', {
        elementType: elementType,
        sources: null,
        context: 'index',
        showStatusMenu: true,
        showSiteMenu: false,
        toolbarFlexible: true,
    }) }}
{% endblock %}

{% block actionButton %}
    <a href="{{ url('leads/popups/new') }}" class="btn submit">{{ 'New Popup'|t('leads') }}</a>
{% endblock %}
